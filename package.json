{
  "name": "germbusters",
  "scripts": {
    "build": "node rollup/build.js && npm-run-all build-clean --parallel css js copy --sequential build-vendors",
    "production": "FRAPPE_ENV=production node rollup/build.js",
    "watch": "npm run watch-html-source",
    "cypress:run": "cypress run --record --key 4a48f41c-11b3-425b-aa88-c58048fa69eb",
    "cypress:open": "cypress open",
    "build-clean": "rimraf dist",
    "build-copy": "copyfiles -a -e \"dashboard/src/scss/**/*\" -e \"dashboard/src/css/**/*\" -e \"dashboard/src/js/**/*\" -u 1 \"dashboard/src/**/*\" dist/",
    "build-vendors": "node dashboard/build/vendors.js",
    "copy": "npm-run-all --parallel copy-*",
    "copy-assets": "copyfiles -a -u 1 \"dashboard/src/assets/**/*\" dist/",
    "copy-views": "copyfiles -a -u 1 \"dashboard/src/**/*.html\" dist/",
    "css": "npm-run-all --parallel css-compile* --sequential css-prefix css-minify*",
    "css-compile": "node-sass --output-style expanded --source-map true --source-map-contents true --precision 8 dashboard/src/scss/style.scss dist/css/style.css",
    "css-compile-vendors": "node dashboard/build/vendors-sass.js",
    "css-lint": "stylelint --config dashboard/build/.stylelintrc --syntax scss \"dashboard/src/scss/**/*.scss\"",
    "css-minify": "cleancss --level 1 --source-map --source-map-inline-sources --output dashboard/dist/css/style.min.css dashboard/dist/css/style.css",
    "css-prefix": "postcss --config build/postcss.config.js --replace \"dist/css/*.css\" \"!dashboard/dist/css/*.min.css\"",
    "js": "npm-run-all --parallel js-compile* ",
    "js-compile": "cross-env PLUGINS=true babel dashboard/src/js/ --out-dir dashboard/dist/js/ --source-maps",
    "js-lint": "eslint dashboard/src/js/src",
    "js-minify": "foreach -g \"dashboard/dist/js/**/*.js\" -x \"uglifyjs --compress typeofs=false --mangle  --source-map \"content=dashboard/src/js/#{name}.js.map,includeSources,url=#{name}.min.js.map\" --output dist/js/#{name}.min.js dist/js/#{name}.js\"",
    "localhost": "browser-sync start --server \"./dist\" --serveStatic \"./\" --files \"./dashboard/dist/**/*, !./dashboard/dist/**/*.html, !./dashboard/dist/vendors/**/*\"",
    "localhost-reload": "browser-sync reload",
    "pug": "npm-run-all --parallel pug-*",
    "pug-dist": "node dashboard/build/pug.js --src pug/ --dest dashboard/dist/ --injectVendors false --injectSvg false",
    "pug-src": "node dashboard/build/pug.js --src pug/ --dest dashboard/src/ --injectSvg false",
    "release-version": "node dashboard/build/change-version.js",
    "serve": "npm-run-all --sequential build localhost",
    "svg": "node dashboard/build/svg.js",
    "sync-assets": "sync-glob --watch 'dashboard/src/assets/**/*' dashboard/dist/assets",
    "test-dist": "browser-sync start --server \"./dashboard/dist\"",
    "watch-pug-source": "npm-run-all --parallel watch-pug sync-assets watch-js watch-css",
    "watch-html-source": "npm-run-all --parallel sync-assets watch-views watch-js watch-css",
    "watch-css": "nodemon -e scss -x \"npm run css\"",
    "watch-js": "nodemon -e js -x \"npm run js\"",
    "watch-pug": "node dashboard/build/watch-pug.js",
    "watch-views": "nodemon -e html -x \"npm-run-all --sequential copy-views build-vendors svg localhost-reload\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frappe/frappe.git"
  },
  "author": "Mygermbusters.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/frappe/frappe/issues"
  },
  "homepage": "https://frappe.io",
  "dependencies": {
    "@coreui/chartjs": "^2.0.0",
    "@coreui/coreui": "^3.0.0",
    "@coreui/icons": "^1.0.1",
    "@coreui/utils": "^1.2.2",
    "@fullcalendar/bootstrap": "^4.4.0",
    "@fullcalendar/core": "^4.4.0",
    "@fullcalendar/daygrid": "^4.4.0",
    "@fullcalendar/google-calendar": "^4.4.0",
    "@fullcalendar/interaction": "^4.4.0",
    "@fullcalendar/list": "^4.4.0",
    "@fullcalendar/timegrid": "^4.4.0",
    "@popperjs/core": "^2.0.6",
    "ace-builds": "^1.4.1",
    "awesomplete": "^1.1.2",
    "bootstrap": "^4.4.1",
    "bootstrap-datepicker": "^1.9.0",
    "chart.js": "^2.9.3",
    "cookie": "^0.3.1",
    "datatables.net-dt": "^1.10.20",
    "express": "^4.16.2",
    "fast-deep-equal": "^2.0.1",
    "frappe-charts": "^1.3.0",
    "frappe-datatable": "^1.14.0",
    "frappe-gantt": "^0.1.0",
    "fuse.js": "^3.2.0",
    "highlight.js": "^9.12.0",
    "jquery": "^3.3.1",
    "jquery-timepicker": "^1.3.3",
    "js-sha256": "^0.9.0",
    "jsbarcode": "^3.9.0",
    "lazysizes": "^5.2.0",
    "leaflet": "^1.6.0",
    "leaflet-draw": "^1.0.4",
    "leaflet-easybutton": "^2.4.0",
    "leaflet-routing-machine": "^3.2.12",
    "leaflet.fullscreen": "1.6.0",
    "leaflet.locatecontrol": "^0.71.1",
    "moment": "^2.20.1",
    "moment-timezone": "^0.5.21",
    "nexmo": "^2.6.0",
    "nexmo-cli": "^0.3.15",
    "perfect-scrollbar": "1.5.0",
    "popper.js": "^1.14.7",
    "quagga": "^0.12.1",
    "quill": "2.0.0-dev.2",
    "qz-tray": "^2.0.8",
    "redis": "^2.8.0",
    "showdown": "^1.9.1",
    "socket.io": "^2.0.4",
    "superagent": "^3.8.2",
    "touch": "^3.1.0",
    "vue": "^2.6.8",
    "vue-router": "^2.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.8.4",
    "@babel/core": "^7.8.4",
    "@babel/plugin-proposal-object-rest-spread": "^7.8.3",
    "@babel/preset-env": "^7.8.4",
    "@coreui/svg-injector": "^1.0.0",
    "@coreui/vendors-injector": "^1.0.2",
    "autoprefixer": "^9.7.4",
    "babel-eslint": "^10.0.3",
    "babel-plugin-transform-es2015-modules-strip": "^0.1.1",
    "babel-runtime": "^6.26.0",
    "browser-sync": "^2.26.7",
    "chalk": "^3.0.0",
    "clean-css-cli": "^4.3.0",
    "copyfiles": "^2.2.0",
    "cross-env": "^7.0.0",
    "cypress": "^3.1.1",
    "cypress-file-upload": "^3.1.0",
    "eslint": "^6.8.0",
    "eslint-config-xo": "^0.29.1",
    "eslint-plugin-import": "^2.20.1",
    "eslint-plugin-unicorn": "^16.1.1",
    "foreach-cli": "^1.8.1",
    "js-beautify": "^1.10.3",
    "jsdom": "^16.2.0",
    "less": "^3.0.4",
    "minimist": "^1.2.0",
    "node-sass": "^4.13.1",
    "nodemon": "^2.0.2",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^7.1.0",
    "postcss-combine-duplicated-selectors": "^8.1.0",
    "postcss-merge-rules": "^4.0.3",
    "pug": "^2.0.4",
    "rimraf": "^3.0.2",
    "rollup": "^1.2.2",
    "rollup-plugin-buble": "^0.19.2",
    "rollup-plugin-commonjs": "^8.3.0",
    "rollup-plugin-multi-entry": "^2.0.2",
    "rollup-plugin-node-resolve": "^4.0.1",
    "rollup-plugin-postcss": "^2.0.3",
    "rollup-plugin-terser": "^4.0.4",
    "rollup-plugin-vue": "4.2.0",
    "shelljs": "^0.8.3",
    "stylelint": "^13.2.0",
    "stylelint-config-recommended-scss": "^4.2.0",
    "stylelint-config-standard": "^20.0.0",
    "stylelint-order": "^4.0.0",
    "stylelint-scss": "^3.14.2",
    "sync-glob": "^1.4.0",
    "vue-template-compiler": "^2.6.8",
    "webpack": "^4.20.2",
    "webpack-cli": "^3.1.1"
  }
}
